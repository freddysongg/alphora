# Root .env loaded by docker compose. Per-service env lives in services/api/.env.example.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# Required in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_BOX_KEY=

# Public URL the browser uses to call the API. In compose, the api container is reachable as `api:8000`
# inside the network, but browsers hit it at localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

NODE_ENV=production
