ENVIRONMENT=development
API_PREFIX=/api
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://alphora:alphora@localhost:5432/alphora
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
LOG_JSON=true

# Fernet key for encrypting provider API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Development falls back to a deterministic dev-only key.
SECRET_BOX_KEY=

# Alpaca trading + market data (Phase 0).
# Get keys from https://app.alpaca.markets/paper/dashboard/overview
# ALPACA_MODE controls which endpoint is hit: "paper" or "live".
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_MODE=paper

# Rotating human-issued token gating live order approval. Required only
# when ALPACA_MODE=live or when promoting a paper run to live.
HUMAN_APPROVAL_TOKEN=
